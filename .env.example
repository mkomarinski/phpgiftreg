# Example environment configuration for phpGiftReg
# Copy this file to .env and update the values for your environment.
# These values are read by src/includes/config.php via getenv().

# Database settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=giftreg
DB_USER=giftreg
DB_PASSWORD=change-me

# OIDC / SSO settings
OIDC_ENABLED=0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_AUTO_PROVISION=0
OIDC_AUTO_APPROVE=0
OIDC_PROMPT=
OIDC_REDIRECT_URI=

# Optional app settings (matches the defaults in src/includes/config.php)
# Uncomment and set any values you want to override the defaults.
# EVENT_THRESHOLD=60
# SHOP_REQUIRES_APPROVAL=1
# NEWUSER_REQUIRES_APPROVAL=1
# ANONYMOUS_PURCHASING=0
# ITEMS_PER_PAGE=10
# EMAIL_FROM=webmaster@localhost
# EMAIL_REPLY_TO=webmaster@localhost
# EMAIL_XMAILER=PHP
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=tls
# SMTP_AUTH=0
# SMTP_IGNORE_INVALID_CERT=0
# SHOW_HELPTEXT=0
# CONFIRM_ITEM_DELETES=0
# ALLOW_MULTIPLES=1
# CURRENCY_SYMBOL=$
# DATE_FORMAT=m/d/Y
# SHOW_OWN_EVENTS=1
# PASSWORD_LENGTH=8
# HIDE_ZERO_PRICE=1
# ALLOW_IMAGES=1
# IMAGE_SUBDIR=item_images
# NOTIFY_THRESHOLD_MINUTES=60
