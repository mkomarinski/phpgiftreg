<section class="page-heading"><div><p class="eyebrow">For the people you love</p><h1>My shopping list</h1><p class="lead">Reserved and purchased gifts across your shared lists.</p></div><a class="quiet-link" href="/">Back to overview</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Status</th><th>Gift</th><th>For</th><th>Where</th><th>Quantity</th><th>Price</th></tr></thead><tbody><% for (const item of page.items) { %><tr><td><span class="pill <%= item.bought ? 'complete' : '' %>"><%= item.bought ? 'Bought' : 'Reserved' %></span></td><td><strong><%= item.description %></strong></td><td><%= item.owner_name %></td><td><%= item.source || '-' %></td><td><%= item.quantity %></td><td><%= settings.currency_symbol %><%= (item.price * item.quantity).toFixed(2) %></td></tr><% } %><% if (!page.items.length) { %><tr><td colspan="6" class="empty">Your shopping list is empty.</td></tr><% } %></tbody></table></div><div class="summary-row"><span>Purchased total</span><strong><%= settings.currency_symbol %><%= page.total.toFixed(2) %></strong></div></section>
