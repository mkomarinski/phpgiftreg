<section class="page-heading"><div><p class="eyebrow">Shopping for</p><h1><%= page.owner.fullname %></h1><p class="lead"><%= page.owner.comment || 'A little inspiration for a thoughtful gift.' %></p></div><a class="quiet-link" href="/">Back to overview</a></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Gift idea</th><th>Rank</th><th>Price</th><th>Availability</th><th>Reserve / purchase</th></tr></thead><tbody>
<% for (const item of page.items) { %><tr><td><strong><%= item.description %></strong><% if (item.comment) { %><small><%= item.comment %></small><% } %><% if (item.url) { %><small><a href="<%= item.url %>" target="_blank" rel="noreferrer">Open item link</a></small><% } %><% if (item.allocationNames.length) { %><small><%= item.allocationNames.join(' · ') %></small><% } %></td><td><%= item.rank_title || '-' %></td><td><%= page.settings.currency_symbol %><%= Number(item.price).toFixed(2) %></td><td><%= item.available %> of <%= item.quantity %> available</td><td><div class="allocation-stack">
<% if (item.available > 0) { %><form method="post" action="/allocations" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="item_id" value="<%= item.id %>"><input type="hidden" name="action" value="reserve"><input aria-label="Quantity to reserve" type="number" name="quantity" min="1" max="<%= item.available %>" value="1"><button class="button small primary">Reserve</button></form><% } %>
<% if (item.mineReserved) { %><form method="post" action="/allocations" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="item_id" value="<%= item.id %>"><input type="hidden" name="action" value="purchase"><input type="hidden" name="quantity" value="<%= item.mineReserved %>"><button class="button small secondary">Mark bought</button></form><form method="post" action="/allocations" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="item_id" value="<%= item.id %>"><input type="hidden" name="action" value="release"><input type="hidden" name="quantity" value="<%= item.mineReserved %>"><button class="text-button">Release</button></form><% } %><% if (item.mineBought) { %><form method="post" action="/allocations" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="item_id" value="<%= item.id %>"><input type="hidden" name="action" value="return"><input type="hidden" name="quantity" value="<%= item.mineBought %>"><button class="button small secondary">Undo purchase</button></form><% } %></div></td></tr><% } %><% if (!page.items.length) { %><tr><td colspan="5" class="empty">This list is waiting for its first gift idea.</td></tr><% } %></tbody></table></div></section>
