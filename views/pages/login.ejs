<section class="auth-panel"><p class="eyebrow">Welcome back</p><h1>Sign in</h1><form method="post" action="/login" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Username<input name="username" autocomplete="username" required autofocus></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="button primary full">Sign in</button></form>
<% if (settings.oidc_enabled === '1') { %><div class="auth-divider"><span>or continue with</span></div><a class="button secondary full" href="/auth/oidc/login">OpenID Connect</a><% } %><p class="auth-note">Need an account? <a href="/signup">Request access</a></p><p class="auth-note">First time here? <a href="/setup">Create the registry administrator</a></p></section>
