<section class="page-heading"><div><p class="eyebrow">Mark the moment</p><h1>Events</h1><p class="lead">Add birthdays and occasions so your circle has time to plan.</p></div></section><section class="panel form-panel"><h2>Add an event</h2><form method="post" action="/events" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Event name<input name="description" maxlength="100" required placeholder="Birthday"></label><label>Date<input name="event_date" type="date" required></label><label class="check-row"><input type="checkbox" name="recurring" value="1"> Repeats every year</label><% if (user.admin) { %><label class="check-row"><input type="checkbox" name="system_event" value="1"> Show as a shared event</label><% } %><div class="form-actions"><button class="button primary">Add event</button></div></form></section><section class="panel"><div class="section-heading"><div><p class="eyebrow">Your calendar</p><h2>Saved events</h2></div></div><% if (!page.events.length) { %><p class="empty">No events yet.</p><% } %><div class="event-management"><% for (const event of page.events) { %><article class="event-manage-row"><form method="post" action="/events" class="inline-form event-edit"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="event_id" value="<%= event.id %>"><input name="description" value="<%= event.description %>" maxlength="100" required><input name="event_date" type="date" value="<%= event.event_date %>" required><label class="check-row"><input type="checkbox" name="recurring" value="1" <%= event.recurring ? 'checked' : '' %>> Yearly</label><% if (event.user_id === null && user.admin) { %><label class="check-row"><input type="checkbox" name="system_event" value="1" checked> Shared</label><% } %><button class="button small secondary">Save</button></form><form method="post" action="/events/<%= event.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button danger-text">Delete</button></form></article><% } %></div></section>
