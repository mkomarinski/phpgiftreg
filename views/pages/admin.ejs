<section class="page-heading"><div><p class="eyebrow">Registry controls</p><h1>Administration</h1><p class="lead">Manage accounts, family circles, and how the registry behaves.</p></div></section>
<nav class="admin-tabs" aria-label="Admin sections"><a href="#accounts">Accounts</a><a href="#families">Families</a><a href="#guardianships">Guardians</a><a href="#catalog">Lists</a><a href="#settings">Settings</a><a href="#announcements">Announcements</a></nav>
<section class="panel admin-section" id="accounts"><div class="section-heading"><div><p class="eyebrow">People</p><h2>Accounts</h2></div><span class="count"><%= page.users.length %></span></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Username / email</th><th>Status</th><th>Access</th><th>Actions</th></tr></thead><tbody><% for (const account of page.users) { %><tr><td><strong><%= account.fullname %></strong></td><td><%= account.username %><small><%= account.email || 'No email' %></small></td><td><span class="pill <%= account.approved ? 'complete' : '' %>"><%= account.approved ? 'Approved' : 'Awaiting approval' %></span></td><td><%= account.admin ? 'Administrator' : 'Member' %></td><td><div class="inline-actions"><% if (!account.approved) { %><form method="post" action="/admin/users/<%= account.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="approve"><button class="button small primary">Approve</button></form><form method="post" action="/admin/users/<%= account.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="reject"><button class="button small secondary">Reject</button></form><% } %><% if (account.id !== user.id) { %><form method="post" action="/admin/users/<%= account.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="toggle-admin"><button class="button small secondary"><%= account.admin ? 'Remove admin' : 'Make admin' %></button></form><form method="post" action="/admin/users/<%= account.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="delete"><button class="text-button danger-text">Delete</button></form><% } %></div></td></tr><% } %></tbody></table></div></section>
<section class="panel admin-section" id="families"><div class="section-heading"><div><p class="eyebrow">Circles</p><h2>Families</h2></div></div><form method="post" action="/admin/families" class="inline-form add-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="insert"><input name="name" placeholder="New family name" required><button class="button small primary">Add family</button></form>
<% for (const family of page.families) { %><article class="family-row"><div class="section-heading compact"><div><form method="post" action="/admin/families" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="update"><input type="hidden" name="family_id" value="<%= family.id %>"><input name="name" value="<%= family.name %>" required><button class="button small secondary">Rename</button></form><small><%= family.member_count %> members</small></div><form method="post" action="/admin/families"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="delete"><input type="hidden" name="family_id" value="<%= family.id %>"><button class="text-button danger-text">Delete family</button></form></div><form method="post" action="/admin/families" class="member-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="members"><input type="hidden" name="family_id" value="<%= family.id %>"><% for (const account of page.users) { %><label class="check-row member-choice"><input type="checkbox" name="member_ids" value="<%= account.id %>" <%= page.familyMembers.some((membership) => membership.user_id === account.id && membership.family_id === family.id) ? 'checked' : '' %>><span><%= account.fullname %><small><%= account.username %></small></span></label><% } %><div class="form-actions span-2"><button class="button small secondary">Save membership</button></div></form></article><% } %></section>
<section class="panel admin-section" id="guardianships"><div class="section-heading"><div><p class="eyebrow">Account relationships</p><h2>Guardianships</h2></div></div><form method="post" action="/admin/guardianships" class="inline-form add-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="add"><label><span class="sr-only">Guardian</span><select name="guardian_id" required><option value="">Guardian</option><% for (const account of page.users) { %><option value="<%= account.id %>"><%= account.fullname %></option><% } %></select></label><span class="relationship-arrow">is guardian of</span><label><span class="sr-only">Child</span><select name="child_id" required><option value="">Child</option><% for (const account of page.users) { %><option value="<%= account.id %>"><%= account.fullname %></option><% } %></select></label><button class="button small primary">Add relationship</button></form><ul class="simple-list"><% for (const link of page.guardianships) { %><li><span><strong><%= link.guardian_name %></strong> is guardian of <strong><%= link.child_name %></strong></span><form method="post" action="/admin/guardianships"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="remove"><input type="hidden" name="guardian_id" value="<%= link.guardian_id %>"><input type="hidden" name="child_id" value="<%= link.child_id %>"><button class="text-button danger-text">Remove</button></form></li><% } %><% if (!page.guardianships.length) { %><li class="empty">No guardian relationships configured.</li><% } %></ul></section>
<section class="panel admin-section" id="catalog"><div class="section-heading"><div><p class="eyebrow">Gift list choices</p><h2>Categories and ranks</h2></div></div><div class="admin-columns"><div><h3>Categories</h3><form method="post" action="/admin/catalog" class="inline-form add-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="category-add"><input name="name" placeholder="Category name" required><button class="button small primary">Add</button></form><ul class="simple-list"><% for (const category of page.categories) { %><li><span><%= category.name %></span><form method="post" action="/admin/catalog"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="category-delete"><input type="hidden" name="id" value="<%= category.id %>"><button class="text-button danger-text">Delete</button></form></li><% } %></ul></div><div><h3>Rankings</h3><form method="post" action="/admin/catalog" class="inline-form add-row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="rank-add"><input name="name" placeholder="Rank label" required><input type="number" name="rank_order" min="0" max="100" value="1" aria-label="Sort order"><button class="button small primary">Add</button></form><ul class="simple-list"><% for (const rank of page.ranks) { %><li><span><%= rank.title %></span><form method="post" action="/admin/catalog"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="rank-delete"><input type="hidden" name="id" value="<%= rank.id %>"><button class="text-button danger-text">Delete</button></form></li><% } %></ul></div></div></section>
<section class="panel admin-section" id="settings"><div class="section-heading"><div><p class="eyebrow">Registry behavior</p><h2>Settings</h2></div></div><form method="post" action="/admin/settings" class="settings-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="settings-grid">
<label>Event reminder window (days)<input type="number" name="event_threshold" min="1" max="3650" value="<%= page.settings.event_threshold %>" required></label><label>Items per page<input type="number" name="items_per_page" min="1" max="100" value="<%= page.settings.items_per_page %>" required></label><label>Currency symbol<input name="currency_symbol" maxlength="10" value="<%= page.settings.currency_symbol %>"></label><label>SMTP host<input name="smtp_host" value="<%= page.settings.smtp_host %>" placeholder="mail.example.org"></label><label>SMTP port<input type="number" name="smtp_port" min="1" max="65535" value="<%= page.settings.smtp_port %>"></label><label>Email sender<input type="email" name="email_from" value="<%= page.settings.email_from %>" placeholder="registry@example.org"></label><label>SMTP username<input name="smtp_username" value="<%= page.settings.smtp_username %>"></label><label>SMTP password<input type="password" name="smtp_password" autocomplete="new-password" placeholder="Leave blank to keep current"></label><label>Notification throttle (minutes)<input type="number" name="notify_threshold_minutes" min="1" max="1440" value="<%= page.settings.notify_threshold_minutes %>" required></label></div>
<div class="toggle-grid"><% for (const [key, label] of [['newuser_requires_approval','Require approval for new accounts'],['shop_requires_approval','Require approval for shopping access'],['anonymous_purchasing','Hide shopper names from other shoppers'],['show_own_events','Show your own events on the dashboard'],['allow_multiples','Allow multiple item quantities'],['hide_zero_price','Hide zero prices'],['smtp_secure','Use SSL/TLS for SMTP'],['oidc_enabled','Enable OpenID Connect sign-in'],['oidc_auto_provision','Create accounts for new verified identities'],['oidc_auto_approve','Approve OIDC-provisioned accounts automatically']]) { %><label class="check-row"><input type="hidden" name="<%= key %>" value="0"><input type="checkbox" name="<%= key %>" value="1" <%= page.settings[key] === '1' ? 'checked' : '' %>><%= label %></label><% } %></div>
<div class="settings-subsection"><h3>OpenID Connect</h3><p class="hint">Register <code><%= page.callbackOverride || page.settings.oidc_redirect_uri || 'https://your-host/auth/oidc/callback' %></code> as the provider callback. Set OIDC_REDIRECT_URI to pin it behind a reverse proxy.</p><div class="settings-grid"><label>Issuer URL<input type="url" name="oidc_issuer" value="<%= page.settings.oidc_issuer %>" placeholder="https://identity.example.org"></label><label>Client ID<input name="oidc_client_id" value="<%= page.settings.oidc_client_id %>"></label><label>Client secret<input type="password" name="oidc_client_secret" autocomplete="new-password" placeholder="Leave blank to keep current"></label><label>Scopes<input name="oidc_scopes" value="<%= page.settings.oidc_scopes %>"></label><label>Callback URL<input type="url" name="oidc_redirect_uri" value="<%= page.settings.oidc_redirect_uri %>" placeholder="Optional; environment can override"></label><label>Prompt parameter<input name="oidc_prompt" value="<%= page.settings.oidc_prompt %>" placeholder="Optional"></label></div></div><div class="form-actions"><button class="button primary">Save settings</button></div></form></section>
<section class="panel admin-section" id="announcements"><div class="section-heading"><div><p class="eyebrow">Messages</p><h2>Send an announcement</h2></div></div><form method="post" action="/admin/announcements" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Recipients<select name="recipients"><option value="all">All approved users</option><option value="selected">Selected users below</option></select></label><div class="member-grid"><% for (const account of page.users.filter((candidate) => candidate.id !== user.id && candidate.approved)) { %><label class="check-row member-choice"><input type="checkbox" name="recipient_ids" value="<%= account.id %>"><span><%= account.fullname %></span></label><% } %></div><label>Message<textarea name="message" rows="4" maxlength="2000" required></textarea></label><button class="button secondary">Send announcement</button></form></section>
