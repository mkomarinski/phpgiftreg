<section class="page-heading"><div><p class="eyebrow">Your wishlist</p><h1><%= page.item.id ? 'Edit gift idea' : 'Add a gift idea' %></h1></div><a class="quiet-link" href="/">Back to overview</a></section><section class="panel form-panel"><form method="post" action="<%= page.item.id ? `/items/${page.item.id}` : '/items' %>" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label class="span-2">Description<input name="description" maxlength="255" required value="<%= page.item.description || '' %>" placeholder="What would make you happy?"></label><label>Price<input type="number" min="0" step="0.01" name="price" required value="<%= page.item.price ?? 0 %>"></label><label>Quantity<input type="number" min="1" max="100" name="quantity" required value="<%= page.item.quantity || 1 %>"></label><label>Where to find it<input name="source" maxlength="255" value="<%= page.item.source || '' %>" placeholder="A shop or website"></label><label>Link<input type="url" name="url" value="<%= page.item.url || '' %>" placeholder="https://"></label><label>Category<select name="category_id"><option value="">No category</option><% for (const category of page.categories) { %><option value="<%= category.id %>" <%= Number(page.item.category_id) === category.id ? 'selected' : '' %>><%= category.name %></option><% } %></select></label><label>How much do you want it?<select name="rank_id"><option value="">Choose a rank</option><% for (const rank of page.ranks) { %><option value="<%= rank.id %>" <%= Number(page.item.rank_id) === rank.id ? 'selected' : '' %>><%= rank.title %></option><% } %></select></label><label class="span-2">Note<textarea name="comment" rows="3" maxlength="2000" placeholder="Optional details"><%= page.item.comment || '' %></textarea></label><div class="form-actions span-2"><a class="button secondary" href="/">Cancel</a><button class="button primary">Save idea</button></div></form></section>
