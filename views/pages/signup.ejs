<section class="auth-panel"><p class="eyebrow">Join your circle</p><h1>Request an account</h1><form method="post" action="/signup" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Username<input name="username" autocomplete="username" maxlength="80" required></label><label>Full name<input name="fullname" autocomplete="name" maxlength="100" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password <span class="hint">At least 12 characters</span><input type="password" name="password" autocomplete="new-password" minlength="12" required></label>
<% if (page.families.length) { %><label>Family<select name="family_id"><option value="">Choose later</option><% for (const family of page.families) { %><option value="<%= family.id %>"><%= family.name %></option><% } %></select></label><% } %><button class="button primary full">Submit request</button></form><p class="auth-note">Already have an account? <a href="/login">Sign in</a></p></section>
