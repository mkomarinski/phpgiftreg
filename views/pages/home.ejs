<section class="page-heading"><div><p class="eyebrow">Your circle</p><h1>Good to see you, <%= user.fullname.split(' ')[0] %>.</h1><p class="lead">Your ideas, shared lists, and upcoming occasions in one place.</p></div><a class="button primary" href="/items/new">+ Add an idea</a></section>
<div class="dashboard-grid">
<section class="panel wide"><div class="section-heading"><div><p class="eyebrow">Your wishlist</p><h2>Your ideas</h2></div><span class="count"><%= page.items.length %></span></div>
<% if (!page.items.length) { %><p class="empty">Your list is ready for its first idea.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Idea</th><th>Rank</th><th>Price</th><th>Where</th><th></th></tr></thead><tbody><% for (const item of page.items) { %><tr><td><strong><%= item.description %></strong><% if (item.comment) { %><small><%= item.comment %></small><% } %></td><td><span class="rank-label"><%= item.rank_title || 'Unranked' %></span></td><td><%= page.settings.currency_symbol %><%= Number(item.price).toFixed(2) %></td><td><%= item.source || '-' %></td><td class="actions"><a href="/items/<%= item.id %>/edit">Edit</a><form method="post" action="/items/<%= item.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button danger-text" type="submit">Remove</button></form></td></tr><% } %></tbody></table></div><% } %></section>
<section class="panel"><div class="section-heading"><div><p class="eyebrow">Your family</p><h2>Shared lists</h2></div></div>
<% if (!page.familyPeople.length) { %><p class="empty">No approved family members are linked yet. Ask an administrator to add your family membership.</p><% } %><ul class="people-list">
<% for (const person of page.familyPeople) { %><li><div><strong><%= person.fullname %></strong><% if (person.comment) { %><small><%= person.comment %></small><% } %></div>
<% if (person.can_shop) { %><div class="person-controls"><a class="button small" href="/shop/<%= person.id %>">View list</a><form method="post" action="/subscriptions/<%= person.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= page.subscribed.has(person.id) ? 'unsubscribe' : 'subscribe' %>"><button class="text-button" type="submit"><%= page.subscribed.has(person.id) ? 'Unfollow' : 'Follow updates' %></button></form><form method="post" action="/shopping-requests/<%= person.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="cancel"><button class="text-button danger-text" type="submit">Remove access</button></form></div><% } else if (person.pending) { %><span class="pill">Request pending</span><% } else { %><form method="post" action="/shopping-requests/<%= person.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="request"><button class="button small" type="submit">Request access</button></form><% } %></li><% } %></ul></section>
<section class="panel"><div class="section-heading"><div><p class="eyebrow">Coming up</p><h2>Occasions</h2></div><a class="quiet-link" href="/events">Manage</a></div><% if (!page.events.length) { %><p class="empty">Nothing on the calendar in the next <%= page.settings.event_threshold %> days.</p><% } %><ul class="event-list"><% for (const event of page.events) { %><li><span class="event-date"><%= event.days === 0 ? 'TODAY' : `${event.days} DAYS` %></span><div><strong><%= event.description %></strong><small><%= event.fullname || 'Everyone' %> · <%= event.nextDate %></small></div></li><% } %></ul></section>
<% if (page.incoming.length) { %><section class="panel"><div class="section-heading"><div><p class="eyebrow">Needs your attention</p><h2>Shopping requests</h2></div><span class="count"><%= page.incoming.length %></span></div><ul class="people-list"><% for (const request of page.incoming) { %><li><strong><%= request.fullname %></strong><div class="inline-actions"><form method="post" action="/shopping-requests/<%= request.shopper_id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="approve"><button class="button small primary">Approve</button></form><form method="post" action="/shopping-requests/<%= request.shopper_id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="decline"><button class="button small secondary">Decline</button></form></div></li><% } %></ul></section><% } %>
<% if (page.unread.length) { %><section class="panel"><div class="section-heading"><div><p class="eyebrow">Inbox</p><h2>Messages</h2></div><span class="count"><%= page.unread.length %></span></div><ul class="message-list"><% for (const message of page.unread) { %><li><div><strong><%= message.sender_name %></strong><p><%= message.message %></p><small><%= message.created_at %></small></div><form method="post" action="/messages/<%= message.id %>/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Mark read</button></form></li><% } %></ul></section><% } %>
</div>
