<section class="page-heading"><div><p class="eyebrow">Account</p><h1>Your profile</h1><p class="lead">Update your details and notification preferences.</p></div></section><section class="panel form-panel"><form method="post" action="/profile" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Username<input value="<%= page.profile.username %>" disabled></label><label>Full name<input name="fullname" maxlength="100" required value="<%= page.profile.fullname %>"></label><label>Email<input type="email" name="email" required value="<%= page.profile.email || '' %>"></label><label>List note<textarea name="comment" rows="3" maxlength="1000"><%= page.profile.comment || '' %></textarea></label><label class="check-row"><input type="checkbox" name="email_msgs" value="1" <%= page.profile.email_msgs ? 'checked' : '' %>> Email me when I receive registry messages</label><hr><h2>Change password</h2><p class="hint">Leave blank to keep your password. New passwords must have at least 12 characters.</p><label>Current password<input type="password" name="current_password" autocomplete="current-password"></label><label>New password<input type="password" name="new_password" autocomplete="new-password" minlength="12"></label><div class="form-actions"><button class="button primary">Save profile</button></div></form></section>
